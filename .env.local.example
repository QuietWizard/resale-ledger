# Copy this file to .env.local and fill in your own values.

# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The n8n webhook URL that kicks off the identify/research/draft pipeline.
# Matches the Webhook Trigger node's path in n8n/resell-ledger-ai-workflow.json.
NEXT_PUBLIC_N8N_CAPTURE_WEBHOOK_URL=https://your-n8n-host/webhook/resell-research

# Must match the WEBHOOK_SECRET env var set on your n8n instance — sent as the
# x-webhook-secret header on every capture request.
NEXT_PUBLIC_N8N_WEBHOOK_SECRET=your-webhook-secret

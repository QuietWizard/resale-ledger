# Copy this file to .env.local and fill in your own values.

# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The n8n webhook URL that kicks off the identify/research/draft pipeline.
# e.g. https://n8n.yourhomelab.tld/webhook/resale-capture
NEXT_PUBLIC_N8N_CAPTURE_WEBHOOK_URL=https://your-n8n-host/webhook/resale-capture
